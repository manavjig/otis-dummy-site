---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const services = [
	{ number: '01', title: 'Preventive maintenance', text: 'A practical service plan that catches small issues before they become a tenant call, a shutdown, or a surprise invoice.', label: 'Keep it moving' },
	{ number: '02', title: 'Modernization', text: 'Thoughtful upgrades for controls, doors, cabs, and accessibility—with a plan that respects your building and your budget.', label: 'Make it better' },
	{ number: '03', title: 'Emergency response', text: 'A local team on call day and night, with real updates from a real person until your elevator is safely back in service.', label: 'Get help now' },
	{ number: '04', title: 'Inspections & compliance', text: 'Clear records, proactive reminders, and an experienced partner for TSSA inspections and building requirements.', label: 'Stay ready' },
];

const logos = ['CIVIC', 'MACKENZIE', 'harbour & co.', 'NORTH / 42', 'Dwellwell'];
const shareImage = 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1600&q=80';
const schema = {
	'@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': 'https://otiselevatorservices.ca/#business', name: 'Otis Elevator Services', url: 'https://otiselevatorservices.ca', telephone: '+1-416-555-0187', email: 'hello@otiselevatorservices.ca', description: SITE_DESCRIPTION, image: shareImage, priceRange: '$$',
	address: { '@type': 'PostalAddress', streetAddress: '240 King Street East, Suite 410', addressLocality: 'Toronto', addressRegion: 'ON', postalCode: 'M5A 1K1', addressCountry: 'CA' },
	areaServed: ['Toronto', 'North York', 'Scarborough', 'Etobicoke', 'Mississauga', 'Markham'], openingHours: 'Mo-Su 00:00-24:00',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={shareImage} />
		<meta name="theme-color" content="#f4f1e9" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-dot"></span> Toronto elevator service, since 1998</p>
					<h1 id="hero-title">Keep your building <em>moving.</em></h1>
					<p class="hero-lede">Reliable elevator care for the people and places that keep Toronto going. Fewer surprises, clearer answers, and a local team that picks up.</p>
					<div class="hero-actions"><a class="button button-dark" href="#contact">Book a site visit <span aria-hidden="true">↗</span></a><a class="text-link" href="tel:+14165550187">Call 416 555 0187 <span aria-hidden="true">→</span></a></div>
					<div class="hero-notes"><span><strong>24/7</strong> emergency response</span><span class="note-divider"></span><span><strong>45 min</strong> average GTA arrival</span></div>
				</div>
				<div class="hero-visual"><div class="hero-image-wrap"><img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=1500&q=85" alt="Elevator technician inspecting equipment in a modern building" width="900" height="1100" fetchpriority="high" /></div><div class="hero-stamp" aria-label="Otis Elevator Services local service badge"><svg viewBox="0 0 100 100" aria-hidden="true"><path id="stampPath" d="M 50,50 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0" fill="none"/><text><textPath href="#stampPath">OTIS ELEVATOR SERVICES · TORONTO · </textPath></text></svg><div class="stamp-mark"><span>OE</span><i></i></div></div><div class="hero-caption"><span class="caption-line"></span><span>Engineered for everyday.</span></div></div>
			</section>

			<section class="logo-row" aria-label="Selected clients"><p>Chosen by property teams who care about the details</p><div class="logos">{logos.map((logo) => <span>{logo}</span>)}</div></section>

			<section class="intro section-shell" aria-labelledby="intro-title"><div class="section-kicker">01 <span></span> The Otis difference</div><div class="intro-grid"><h2 id="intro-title">Good service should feel <em>uncomplicated.</em></h2><div class="intro-body"><p>Elevators are complex. Getting them cared for shouldn’t be. Otis brings experienced technicians, modern reporting, and the kind of communication property managers wish every vendor had.</p><a class="text-link" href="#approach">How we work <span aria-hidden="true">↗</span></a></div></div><div class="stat-grid"><div><strong>28</strong><span>years keeping<br />Toronto moving</span></div><div><strong>6,000+</strong><span>units cared for<br />across the GTA</span></div><div><strong>4.9/5</strong><span>average customer<br />rating</span></div><div><strong>100%</strong><span>locally dispatched<br />service calls</span></div></div></section>

			<section class="services section-shell" id="services" aria-labelledby="services-title"><div class="section-kicker">02 <span></span> What we do</div><div class="services-heading"><h2 id="services-title">A steady hand at <em>every level.</em></h2><p>From a quiet morning inspection to a late-night call, our work is built around safety, uptime, and less work for your team.</p></div><div class="service-grid">{services.map((service) => <article class="service-card"><div class="service-top"><span>{service.number}</span><span class="service-arrow" aria-hidden="true">↗</span></div><h3>{service.title}</h3><p>{service.text}</p><a href="#contact">{service.label} <span aria-hidden="true">→</span></a></article>)}</div></section>

			<section class="feature section-shell" id="approach" aria-labelledby="feature-title"><div class="feature-image"><img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1300&q=85" alt="Otis technician working on elevator controls" loading="lazy" width="1300" height="950" /><span class="image-tag">On the tools / 08:42 AM</span></div><div class="feature-copy"><div class="section-kicker">03 <span></span> The Otis standard</div><h2 id="feature-title">We leave your team with <em>confidence.</em></h2><p>Every visit comes with a plain-English update, photo notes when they help, and a next step you can actually act on. That’s how a service call becomes a better building.</p><ul class="check-list"><li><span>✓</span> A named account lead who knows your building</li><li><span>✓</span> Digital reports delivered the same day</li><li><span>✓</span> Clear options before any repair proceeds</li></ul><a class="button button-outline" href="#contact">Meet the team <span aria-hidden="true">↗</span></a></div></section>

			<section class="building-types section-shell" aria-labelledby="building-title"><div class="section-kicker">04 <span></span> Built for your building</div><div class="building-heading"><h2 id="building-title">Different buildings.<br /><em>Same standard.</em></h2><a class="text-link" href="#contact">Tell us about yours <span aria-hidden="true">↗</span></a></div><div class="building-grid"><a href="#contact" class="building-card building-card-tall"><img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1000&q=80" alt="Toronto commercial tower exterior" loading="lazy" width="1000" height="1300" /><span>Commercial towers <b>↗</b></span></a><a href="#contact" class="building-card"><img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1000&q=80" alt="Condominium building exterior" loading="lazy" width="1000" height="900" /><span>Condominiums <b>↗</b></span></a><a href="#contact" class="building-card"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=80" alt="Modern residential lobby" loading="lazy" width="1000" height="900" /><span>Residential &amp; mixed-use <b>↗</b></span></a></div></section>

			<section class="process section-shell" aria-labelledby="process-title"><div class="section-kicker">05 <span></span> A better way to work</div><div class="process-heading"><h2 id="process-title">From first hello to <em>smooth rides.</em></h2><p>One partner, one clear plan, and no chasing people for answers.</p></div><div class="process-grid"><div><span>01</span><h3>Listen</h3><p>We learn your building, your pressures, and what “good” looks like for your residents or tenants.</p></div><div><span>02</span><h3>Assess</h3><p>Our technicians walk the equipment and turn observations into a practical, prioritized plan.</p></div><div><span>03</span><h3>Act</h3><p>We do the work safely, keep you posted, and leave the space cleaner than we found it.</p></div><div><span>04</span><h3>Improve</h3><p>With regular reporting, you see patterns early and make smarter decisions over time.</p></div></div></section>

			<section class="quote-section" aria-label="Customer testimonial"><div class="quote-mark">“</div><blockquote>Otis gives us the rare combination of technical expertise and great communication. Our residents notice the difference.</blockquote><div class="quote-author"><span class="author-avatar">JM</span><span><strong>Jordan McLeod</strong><small>Property Director, Harbour &amp; Co.</small></span></div></section>

			<section class="faq section-shell" aria-labelledby="faq-title"><div class="section-kicker">06 <span></span> Questions, answered</div><div class="faq-grid"><h2 id="faq-title">Good to <em>know.</em></h2><div class="faq-list"><details open><summary>Where does Otis service? <span>+</span></summary><p>We dispatch across Toronto and the GTA, including North York, Scarborough, Etobicoke, Mississauga, Markham, and Vaughan.</p></details><details><summary>How quickly can you respond to an emergency? <span>+</span></summary><p>Our emergency line is open 24/7. In the core GTA, our average arrival is 45 minutes, depending on traffic and site access.</p></details><details><summary>Can you work with our existing provider? <span>+</span></summary><p>Yes. We regularly support buildings during provider transitions, modernization projects, and independent inspections.</p></details><details><summary>Do you provide quotes for modernization? <span>+</span></summary><p>We do. Start with a no-obligation site visit and we’ll outline options, timelines, and the decisions that matter.</p></details></div></div></section>

			<section class="contact section-shell" id="contact" aria-labelledby="contact-title"><div class="contact-inner"><div><p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> Let’s talk about your building</p><h2 id="contact-title">Ready for a smoother <em>ride?</em></h2><p>Tell us a little about your building and we’ll get back to you within one business day.</p></div><form class="contact-form"><label>Name<input type="text" name="name" placeholder="Your name" /></label><label>Work email<input type="email" name="email" placeholder="you@company.com" /></label><label>How can we help?<textarea name="message" rows="3" placeholder="Maintenance, modernization, an urgent issue…"></textarea></label><button class="button button-light" type="submit">Start a conversation <span aria-hidden="true">↗</span></button><small>By submitting, you agree to hear from Otis Elevator Services about your request.</small></form></div></section>
		</main>
		<Footer />
	</body>
</html>
